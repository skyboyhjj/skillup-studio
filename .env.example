# Meta-Skill.org 环境变量
# 复制此文件为 .env 并填入实际值

# JWT 密钥（必填，生成方式: openssl rand -hex 32）
SECRET_KEY=your-secret-key-here

# 数据库密码（必填）
DB_PASSWORD=your-db-password-here

# DeepSeek API Key（可选，不填则 AI 助手使用本地模式）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# CORS 允许的源（生产环境使用正式域名）
CORS_ORIGINS=https://meta-skill.org,http://localhost:8088

# 日志级别
LOG_LEVEL=INFO