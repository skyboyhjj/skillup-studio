@meta {
  file: "domain_scholarly.wrl",
  version: "1.0",
  description: "领域规则 —— 学术考据视角预设，可修改（按需调整）",
  calibration_status: "v1.0_initial",
  date: "2026-08-06"
}

# ═══════════════════════════════════════════════
# 领域规则 (D): 特定领域的配置预设，可修改（按需调整）
# 修改权限: 终端用户
# ═══════════════════════════════════════════════

@rule D-SCHOLARLY {
  category: "D",
  name: "学术考据视角",
  source: {
    type: "domain_config",
    reference: "config_scholarly.json"
  },
  mutability: "configurable",
  description: "强调 L4 学术深度 + 金水理性思维，适合研究经典文本的版本差异和跨文化比较",

  # 规则覆盖 (overrides)
  overrides: {
    "H-DEPTH-WEIGHTS": {
      "L1": 0.5,
      "L2": 1.0,
      "L3": 2.0,
      "L4": 4.0
    },
    "H-DOMINANCE": {
      "threshold": 25.0
    },
    "H-SCARCITY": {
      "threshold": 8.0
    },
    "H-ENTROPY-CLASS": {
      "high": 0.80,
      "low": 0.45
    }
  },

  # 五行偏置
  wuxing_bias: {
    "木": 0.8,
    "火": 0.5,
    "土": 1.0,
    "金": 1.5,
    "水": 1.5
  },
  wuxing_bias_note: "金 1.5（强调逻辑推理）、水 1.5（强调深层探索），木/火降低偏置",

  # 道境参数
  dao_realm: {
    theta_base: 75,
    theta_base_note: "学术视角高门槛，需要更深的积累才能触发'化'",
    case_type: "smooth",
    case_type_label: "顺境·全域跃迁"
  },

  # 适用场景
  applicable_scenarios: [
    "经典文本研究（如《道德经》版本差异）",
    "跨文化哲学比较",
    "学术论文五行分析",
    "知识谱系追踪"
  ],

  affects: ["all diagnostic outputs"],
  depends_on: ["H-DOMINANCE", "H-SCARCITY", "H-ENTROPY-CLASS", "H-DEPTH-WEIGHTS", "F-THETA"],
  validation: {
    rule: "all wuxing_bias values > 0",
    rationale: "偏置系数必须为正数"
  },
  code_location: "config_scholarly.json (planned)"
}

@rule D-PRACTICAL {
  category: "D",
  name: "实践视角预设",
  source: {
    type: "domain_config",
    reference: "config_practical.json"
  },
  mutability: "configurable",
  description: "强调 L3 实践深度 + 木火创新传播，适合管理实践分析和商业策略评估",

  overrides: {
    "H-DEPTH-WEIGHTS": {
      "L1": 0.5,
      "L2": 1.0,
      "L3": 4.0,
      "L4": 1.0
    },
    "H-DOMINANCE": {
      "threshold": 30.0
    },
    "H-SCARCITY": {
      "threshold": 10.0
    },
    "H-ENTROPY-CLASS": {
      "high": 0.85,
      "low": 0.50
    }
  },

  wuxing_bias: {
    "木": 1.5,
    "火": 1.5,
    "土": 1.0,
    "金": 0.8,
    "水": 0.8
  },
  wuxing_bias_note: "木 1.5（强调创新生成）、火 1.5（强调传播协作），金/水降低偏置",

  dao_realm: {
    theta_base: 50,
    theta_base_note: "实践视角低门槛，更容易触发'化'",
    case_type: "smooth",
    case_type_label: "顺境·全域跃迁"
  },

  applicable_scenarios: [
    "管理实践分析",
    "商业策略评估",
    "团队协作诊断",
    "产品创新评估"
  ],

  affects: ["all diagnostic outputs"],
  depends_on: ["H-DOMINANCE", "H-SCARCITY", "H-ENTROPY-CLASS", "H-DEPTH-WEIGHTS", "F-THETA"],
  validation: {
    rule: "all wuxing_bias values > 0",
    rationale: "偏置系数必须为正数"
  },
  code_location: "config_practical.json (planned)"
}

@rule D-EDUCATIONAL {
  category: "D",
  name: "教育视角预设",
  source: {
    type: "domain_config",
    reference: "config_educational.json"
  },
  mutability: "configurable",
  description: "强调 L2 教育深度 + 土木承载，适合儿童成长评估和教育方案设计",

  overrides: {
    "H-DEPTH-WEIGHTS": {
      "L1": 0.5,
      "L2": 3.0,
      "L3": 2.0,
      "L4": 1.0
    },
    "H-DOMINANCE": {
      "threshold": 30.0
    },
    "H-SCARCITY": {
      "threshold": 10.0
    },
    "H-ENTROPY-CLASS": {
      "high": 0.80,
      "low": 0.45
    }
  },

  wuxing_bias: {
    "木": 1.3,
    "火": 0.8,
    "土": 1.5,
    "金": 0.8,
    "水": 0.8
  },
  wuxing_bias_note: "土 1.5（强调承载基础）、木 1.3（强调自然生长），其他降低偏置",

  dao_realm: {
    theta_base: 60,
    case_type: "adverse",
    case_type_label: "逆境·成核生长",
    case_type_note: "教育场景默认逆境模式，临界阈值降低 40%"
  },

  applicable_scenarios: [
    "儿童成长评估（如小禾、小石案例）",
    "教育方案设计",
    "学习路径规划",
    "特殊教育需求评估"
  ],

  affects: ["all diagnostic outputs"],
  depends_on: ["H-DOMINANCE", "H-SCARCITY", "H-ENTROPY-CLASS", "H-DEPTH-WEIGHTS", "F-THETA"],
  validation: {
    rule: "all wuxing_bias values > 0",
    rationale: "偏置系数必须为正数"
  },
  code_location: "config_educational.json (planned)"
}

@rule D-DEFAULT {
  category: "D",
  name: "默认配置",
  source: {
    type: "domain_config",
    reference: "config_default.json"
  },
  mutability: "configurable",
  description: "基准配置，适用于日常通用诊断",

  overrides: {
    "H-DEPTH-WEIGHTS": {
      "L1": 0.5,
      "L2": 1.0,
      "L3": 2.0,
      "L4": 4.0
    },
    "H-DOMINANCE": {
      "threshold": 30.0
    },
    "H-SCARCITY": {
      "threshold": 12.0
    },
    "H-ENTROPY-CLASS": {
      "high": 0.80,
      "low": 0.45
    }
  },

  wuxing_bias: {
    "木": 0.8,
    "火": 0.5,
    "土": 1.0,
    "金": 1.5,
    "水": 1.5
  },
  wuxing_bias_note: "与学术视角相同（默认偏向金水理性思维）",

  dao_realm: {
    diagnosis_mode: "static",
    theta_base: 50,
    theta_base_note: "V1.2 S_p 公式适配: 60→50",
    case_type: "smooth",
    case_type_label: "顺境·全域跃迁"
  },

  applicable_scenarios: [
    "日常通用诊断",
    "AI 领域趋势分析",
    "概念地图五行诊断",
    "月度流水线分析"
  ],

  affects: ["all diagnostic outputs"],
  depends_on: ["H-DOMINANCE", "H-SCARCITY", "H-ENTROPY-CLASS", "H-DEPTH-WEIGHTS", "F-THETA"],
  validation: {
    rule: "all wuxing_bias values > 0",
    rationale: "偏置系数必须为正数"
  },
  code_location: "config_default.json"
}