    "wuxing_circulation": {
      "description": "五行流转引擎：针灸技能从初学到大成的生命周期",
      "stages": {
        "木·种子萌发": {
          "label": "初学阶段",
          "concepts": [
            "认穴",
            "进针",
            "得气",
            "粗守形",
            "正指直刺",
            "无针左右",
            "持针之道坚者为宝"
          ],
          "desc": "从认穴定位到第一次得气。针灸师的种子期——手感、针感、分寸感的建立。",
          "transition_to": "火·繁茂整合",
          "transition_keyword": "得气→气至"
        },
        "火·繁茂整合": {
          "label": "临床成熟",
          "concepts": [
            "补泻",
            "守机",
            "辨证施治",
            "迎随",
            "寒热针法",
            "徐而疾则实",
            "疾而徐则虚",
            "虚则实之",
            "满则泄之"
          ],
          "desc": "得气后进入辨证施治。补泻手法的精熟、寒热虚实的分辨、上守机的敏锐。",
          "transition_to": "金·修剪遗忘",
          "transition_keyword": "守机→忘法"
        },
        "金·修剪遗忘": {
          "label": "技艺升华",
          "concepts": [
            "忘法",
            "精炼",
            "去繁就简",
            "审视血脉",
            "视之独澄",
            "切之独坚",
            "拔刺雪污解结决闭"
          ],
          "desc": "从'有法'到'无法'。手法不再刻意，辨证成为直觉，针下感觉化入骨髓。",
          "transition_to": "水·更新重组",
          "transition_keyword": "忘法→贯通"
        },
        "水·更新重组": {
          "label": "境界突破",
          "concepts": [
            "贯通",
            "以意和之",
            "针道毕矣",
            "令志于针",
            "带功针刺",
            "以神会神",
            "中脉贯气",
            "五气朝神阙"
          ],
          "desc": "针不再是工具，而是医患神气交汇的桥梁。'迎之随之，以意和之'——从技法到心法。",
          "transition_to": "土·迁移沉淀",
          "transition_keyword": "贯通→传承"
        },
        "土·迁移沉淀": {
          "label": "智慧传承",
          "concepts": [
            "沉淀",
            "传承",
            "授徒",
            "择才而教",
            "得其人乃传",
            "非其人勿传",
            "官能",
            "各得其能",
            "灵枢经",
            "令可传于后世"
          ],
          "desc": "从个人技艺到公共智慧。著书立说、择才而教，如《灵枢经》般'令终而不灭，久而不绝'。",
          "transition_to": "木·种子萌发",
          "transition_keyword": "传承→新生"
        }
      },
      "circulation_rule": "五行相生闭环：木（种子）→火（繁茂）→金（修剪）→水（更新）→土（迁移）→木（新一轮种子）。每一轮循环，技能层次螺旋上升。",
      "source": "《灵枢·九针十二原》+ 三层架构映射"
    },
